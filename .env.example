# Copy this file to .env and fill in your own values.
# Do NOT commit your real .env — it's gitignored.

# Server
PORT=4000

# Anthropic — Claude Opus 4.7
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — stores user_profiles (Home Node) + sms_exchanges (audit log)
# See setup.sql for schema. Run it in Supabase SQL Editor before first boot.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Twilio — SMS gateway (required for live webhook)
# Free trial works; production numbers need a paid account.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1234567890
